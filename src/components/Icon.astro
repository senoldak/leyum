    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
  </svg>
)}

{name === 'gater' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19.439 7.85c0-1.571-1.274-2.85-2.85-2.85H14v2.5a1.5 1.5 0 0 1-3 0V5H8.411c-1.576 0-2.85 1.279-2.85 2.85V10h2.5a1.5 1.5 0 0 1 0 3H5.56v2.15c0 1.576 1.274 2.85 2.85 2.85H10v-2.5a1.5 1.5 0 0 1 3 0V18h3.589c1.576 0 2.85-1.274 2.85-2.85V13h-2.5a1.5 1.5 0 0 1 0-3h2.5V7.85z"/>
  </svg>
)}

{name === 'natur' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
  </svg>
)}

{name === 'star' && (
  <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
