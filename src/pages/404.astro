---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout locale="no" title="404 · Fant ikke siden / Sayfa Bulunamadı">
  <div style="text-align: center; padding: 5rem 1rem;">
    <span style="font-size: 5rem; display: block; margin-bottom: 1rem;">🚀💫</span>
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Oisann! Denne siden fløy visst til en annen galakse!</h1>
    <p style="font-size: 1.25rem; color: #64748B; margin-bottom: 2rem;">
      Aradığın sayfa uzay boşluğunda kaybolmuş olabilir.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/no/" class="nav-item" style="background-color: #FFEDD5; color: #EA580C; font-size: 1.1rem; padding: 0.75rem 1.5rem;">
        🇳🇴 Til forsiden (Norsk)
      </a>
      <a href="/tr/" class="nav-item" style="background-color: #E0F2FE; color: #0284C7; font-size: 1.1rem; padding: 0.75rem 1.5rem;">
        🇹🇷 Ana Sayfaya Dön (Türkçe)
      </a>
    </div>
  </div>
</BaseLayout>
