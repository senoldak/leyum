---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getCategory, formatDate } from '../../../lib/site';
import { getPosts, type PostEntry } from '../../../lib/posts';
import { articleGraph } from '../../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPosts('tr');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = getCategory(post.data.category);
const locale = 'tr';
---

<BaseLayout
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  schema={articleGraph(post, locale)}
>
  <article class="article-folio-wrap">
    <header class="article-hero-head">
      {
        cat && (
          <a
            href={`/${locale}/kategori/${cat.slug}/`}
            class="card-cat-badge"
            style={`color: var(--cat-${cat.slug}-ink); background-color: var(--cat-${cat.slug}-surface); font-size: 0.95rem; padding: 0.45rem 1.1rem;`}
          >
            <Icon name={cat.slug} size={18} />
            <span>{cat.title[locale]}</span>
          </a>
        )
      }

      <h1>{post.data.title}</h1>
      <p class="article-hero-lead">{post.data.description}</p>

      <div style="display: flex; align-items: center; justify-content: center; gap: 1.25rem; margin-top: 1.5rem; color: var(--ink-muted); font-size: 0.95rem;">
        <span class="badge-age">🎯 {post.data.ageRange}</span>
        <span>🗓️ {formatDate(post.data.date, locale)}</span>
      </div>
    </header>

    <div class="article-body-prose">
      <Content />
    </div>

    <div style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px dashed #EADBCC; text-align: center;">
      <a
        href={`/${locale}/`}
        class="btn-primary"
        style="background: var(--ink-primary);"
      >
        <span>👈 Ana sayfaya dön</span>
      </a>
    </div>
  </article>
</BaseLayout>
